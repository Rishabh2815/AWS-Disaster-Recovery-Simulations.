# Copy this to terraform.tfvars and fill in your own values.
# Do NOT put db_password here — set it via environment variable instead:
#   export TF_VAR_db_password="something-strong"

primary_region   = "us-east-1"
secondary_region = "us-west-2"

route53_zone_id  = "ZXXXXXXXXXXXXX"    # your existing hosted zone ID
dns_record_name  = "app.yourdomain.com"
